# ─────────────────────────────────────────────────────────────────────────────
# Instituto Ser Melhor — Admin Panel (.env.example)
# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite .env.local no repositório.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase — Projeto ISM (obrigatório)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# URL do site principal (usada pelo preview de posts do Blog e links de visualização)
# Em produção: VITE_SITE_URL=https://www.institutosermelhor.org
# Em dev local: http://localhost:3000
VITE_SITE_URL=http://localhost:3000

# API Gateway — Cloud Functions REST v2 (sem barra no final)
# Em produção: https://southamerica-east1-ismbd-27e84.cloudfunctions.net/api
# Em emulador local: http://localhost:5001/ismbd-27e84/southamerica-east1/api
VITE_API_BASE_URL=https://southamerica-east1-ismbd-27e84.cloudfunctions.net/api
