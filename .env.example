# ─────────────────────────────────────────────────────────────────────────────
# Instituto Ser Melhor — Frontend (.env.example)
# ─────────────────────────────────────────────────────────────────────────────
# Copie este arquivo para .env.local e preencha com os valores reais.
# NUNCA commite .env.local no repositório.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase — Projeto ISM (obrigatório)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# URLs de ambiente (opcional — usado pelo Footer para link "Área Restrita")
# Em produção: VITE_ADMIN_URL=https://admin.institutosermelhor.org/login
# Em dev local: deixar vazio (deriva automaticamente para localhost:3001)
VITE_ADMIN_URL=
